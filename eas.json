{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CHAT_API_URL": "https://boses-bantay-chatbot.boses-bantay-supabase-chatbot.workers.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CHAT_API_URL": "https://boses-bantay-chatbot.boses-bantay-supabase-chatbot.workers.dev"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
