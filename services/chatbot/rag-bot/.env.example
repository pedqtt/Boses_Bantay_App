# Copy to .env in this folder. Never commit the filled-in file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OLLAMA_HOST=http://localhost:11434

# Generate a random chatbot-only key (at least 24 characters).
# Use the matching value for EXPO_PUBLIC_RAG_API_KEY in the mobile root .env.
RAG_API_KEY=

# Optional restart-persistent storage for the local Streamlit/CLI chat.
# The mobile API always uses its own private SQLite session store.
BB_SESSION_BACKEND=memory
